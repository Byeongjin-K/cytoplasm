# Report hub, reminders, and health notifications
# Report hub database.
REPORT_HUB_DB=<path-to-report-hub-database>
# Report hub peer registry file.
REPORT_HUB_PEERS_FILE=<path-to-report-hub-peers>
# Report hub quarantine log.
REPORT_HUB_QUARANTINE_LOG=<path-to-report-hub-quarantine-log>
# Report hub Discord guild identifier.
REPORT_HUB_GUILD_ID=<report-hub-guild-id>
# Report hub channel name.
REPORT_HUB_CHANNEL_NAME=<report-hub-channel-name>
# Report hub polling interval in seconds.
REPORT_HUB_POLL_SECONDS=<poll-seconds>
# Report hub dashboard bind host.
REPORT_HUB_BIND_HOST=<bind-host>
# Report hub dashboard bind port.
REPORT_HUB_BIND_PORT=<bind-port>
# Report hub dashboard username.
