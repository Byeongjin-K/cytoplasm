# Reminder local database.
REMINDER_DB=<path-to-reminder-database>
# Reminder milestone fixture file.
REMINDER_MILESTONES_FILE=<path-to-reminder-milestones>
# Reminder events fixture file.
REMINDER_EVENTS_FILE=<path-to-reminder-events>
# Reminder calendar identifier.
REMINDER_CALENDAR=<calendar-id>
