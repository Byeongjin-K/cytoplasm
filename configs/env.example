REMINDER_DRY_RUN=<dry-run-flag>
# 1/0 forces the node calendar reminder leg on or off (tests); unset reads ~/.hermes/reminder-poller/calendar-events
REMINDER_CALENDAR_EVENTS=<calendar-events-flag>
# Healthcheck notification state file.
HEALTHCHECK_NOTIFY_STATE=<path-to-healthcheck-notify-state>
# Tracked node-config seed used only when generating the healthcheck allowlist manifest.
HEALTHCHECK_NODE_CONFIG_PATH=<path-to-node-config>

# Host serving the dashboards the credential rotation probes hit (default: node config primary node name).
CREDENTIAL_ROTATION_DASHBOARD_HOST=<dashboard-host>

# Memory curation and research automation settings
# Memory curator workspace directory.
MEMORY_CURATOR_DIR=<path-to-memory-curator>
# Memory curator state file.
MEMORY_CURATOR_STATE=<path-to-memory-curator-state>
# Disable memory-curator mutations when set to one.
MEMORY_CURATOR_DRY_RUN=<dry-run-flag>
# Owner-DM message merge window in seconds.
HERMES_OWNER_DM_MERGE_WINDOW_SECONDS=<merge-window-seconds>
# Regression-bank checkout root.
REGRESSION_BANK_ROOT=<path-to-regression-bank-root>
# Regression-bank state file.
REGRESSION_BANK_STATE=<path-to-regression-bank-state>
# Research trends state directory.
RESEARCH_TRENDS_STATE_DIR=<path-to-research-trends-state>
# Research trends report output directory.
RESEARCH_TRENDS_REPORT_DIR=<path-to-research-trends-reports>
# Research trends arXiv endpoint.
RESEARCH_TRENDS_ARXIV_ENDPOINT=<arxiv-endpoint-url>
# Research trends Semantic Scholar endpoint.
RESEARCH_TRENDS_SEMSCHOLAR_ENDPOINT=<sem-scholar-endpoint-url>
# Research trends arXiv retry limit.
RESEARCH_TRENDS_ARXIV_ATTEMPTS=<retry-count>
# Research trends arXiv request interval in seconds.
RESEARCH_TRENDS_ARXIV_INTERVAL_S=<interval-seconds>
# Test-only arXiv failure injection.
RESEARCH_TRENDS_FORCE_ARXIV_FAILURE=<test-only-failure>
# Test-only Semantic Scholar failure injection.
RESEARCH_TRENDS_FORCE_SEMSCHOLAR_FAILURE=<test-only-failure>
# Disable research-trends delivery when set to one.
RESEARCH_TRENDS_DRY_RUN=<dry-run-flag>
# Test-only dynamic failure injection; replace <STAGE> with an internal stage name.
RESEARCH_TRENDS_FAKE_<STAGE>=<test-only-failure>

# Speech-to-text transcription settings (speechtotext skill)
# STT 평가 결과와 오디오 매니페스트를 저장하는 루트 디렉터리(기본값: ~/.hermes/stt-eval).
STT_EVAL_ROOT=<path-to-stt-evaluation-root>
# 평가 후보 실행 시간 상한의 녹음 길이 배수(기본 10).
STT_EVAL_TIMEOUT_FACTOR=<timeout-factor>
# 단어 시각 정렬: none(기본) 또는 whisperx, 실패하면 원 토큰 시각을 보존한다.
SPEECHTOTEXT_ALIGN_BACKEND=<none-or-whisperx>
# 격리 정렬 CLI 경로(미설정이면 STT_ENGINES_VENV 또는 PATH).
SPEECHTOTEXT_ALIGN_BIN=<path-to-stt-engines>
# 아래 정렬 메타데이터는 평가 지문에만 기록되며 격리 엔진의 고정 모델·실행 옵션을 바꾸지 않는다.
SPEECHTOTEXT_ALIGN_MODEL=<alignment-model-identity>
# 평가 지문용 정렬 언어 식별자.
SPEECHTOTEXT_ALIGN_LANGUAGE=<alignment-language-identity>
# 평가 지문용 정렬 시간 예산 식별자(실제 상한은 STT_ENGINES_TIMEOUT_SECONDS).
SPEECHTOTEXT_ALIGN_TIMEOUT=<alignment-timeout-identity>
# 평가 지문용 정렬 장치 식별자.
SPEECHTOTEXT_ALIGN_DEVICE=<alignment-device-identity>
# 평가 지문용 화자 모델 식별자(격리 엔진의 고정 모델을 바꾸지 않음).
SPEECHTOTEXT_DIARIZE_MODEL=<diarization-model-identity>
# 평가 지문용 최소 화자 수 메타데이터(현재 분리 실행 옵션 아님).
SPEECHTOTEXT_DIARIZE_MIN_SPEAKERS=<minimum-speaker-count-identity>
# DTW 토큰 시각 계산은 명시한 whisper 모델 프리셋에만 켠다(기본 꺼짐).
SPEECHTOTEXT_WHISPER_DTW=<whisper-dtw-preset>
# 화자 분리 엔진: sherpa(기본) 또는 pyannote.
SPEECHTOTEXT_DIARIZE_BACKEND=<sherpa-or-pyannote>
# pyannote 분리 모드: regular(래퍼 기본) 또는 exclusive.
SPEECHTOTEXT_DIARIZE_MODE=<regular-or-exclusive>
# 화자 분리 실행 파일과 모델은 설치별 외부 경로로 지정한다.
SPEECHTOTEXT_DIARIZE_BIN=<path-to-diarization-cli>
# sherpa 분할 모델 경로.
SPEECHTOTEXT_DIARIZE_SEGMENTATION=<path-to-segmentation-model>
# sherpa 화자 임베딩 모델 경로.
SPEECHTOTEXT_DIARIZE_EMBEDDING=<path-to-speaker-embedding-model>
# 화자 수 미지정 시 군집 임계값(기본 1.0).
SPEECHTOTEXT_DIARIZE_THRESHOLD=<clustering-threshold>
# 화자 분리 스레드 수.
SPEECHTOTEXT_DIARIZE_THREADS=<thread-count>
# 화자 분리 시간 상한(초).
SPEECHTOTEXT_DIARIZE_TIMEOUT=<timeout-seconds>
# 화자 군집 상한(기본 8).
SPEECHTOTEXT_DIARIZE_MAX_SPEAKERS=<speaker-limit>
# sherpa 최소 발화 길이(초, 기본 0.5).
SPEECHTOTEXT_DIARIZE_MIN_SPEECH=<seconds>
# sherpa 최소 무음 길이(초, 기본 0.0 = 같은 화자의 turn 을 이어 붙이지 않는다).
SPEECHTOTEXT_DIARIZE_MIN_SILENCE=<seconds>
# 소유자가 아는 화자 수(미설정 시 추정).
SPEECHTOTEXT_DIARIZE_SPEAKERS=<speaker-count>
# 1 이면 전사본 초안에 화자 수를 물어 그 수로 한 번 더 나눈다(옵트인).
SPEECHTOTEXT_SPEAKER_COUNT_LLM=<1-or-unset>
# 반복 붕괴 판정 비율(기본 0.08).
SPEECHTOTEXT_MAX_REPEAT=<repeat-ratio>
# whisper 문맥 이월 길이(기본 0, -1이면 모델 기본).
SPEECHTOTEXT_WHISPER_CONTEXT=<context-length>
# whisper 빔 폭(미설정이면 모델 기본).
SPEECHTOTEXT_WHISPER_BEAM_SIZE=<beam-size>
# whisper 무음 판정 임계값.
SPEECHTOTEXT_WHISPER_NO_SPEECH=<no-speech-threshold>
# 비발화 토큰 억제 옵트인.
SPEECHTOTEXT_WHISPER_SUPPRESS_NONSPEECH=<1-or-0>
# Silero VAD 모델 경로(미설정이면 사용하지 않음).
SPEECHTOTEXT_VAD_MODEL=<path-to-vad-model>
# 체크아웃 밖 창 재개 캐시 루트.
SPEECHTOTEXT_WINDOW_CACHE=<path-to-window-cache>
# 로컬 전사 창 길이(밀리초, 기본 900000).
SPEECHTOTEXT_WINDOW_MS=<window-milliseconds>
# 로컬 전사 창 겹침(밀리초, 기본 15000).
SPEECHTOTEXT_WINDOW_OVERLAP_MS=<overlap-milliseconds>
# 격리 STT 서브서비스 venv 절대 경로(메인 Python과 분리).
STT_ENGINES_VENV=<path-to-stt-engines-venv>
# 격리 모델 다운로드·추론 시간 상한(초, 기본 3600).
STT_ENGINES_TIMEOUT_SECONDS=<timeout-seconds>
# Transcription API credential; also read by the Drive watcher's child process.
OPENAI_API_KEY=<openai-api-key>
# Transcription backend: auto (local when available), local (never falls back), or api.
SPEECHTOTEXT_BACKEND=<auto-local-or-api>
# OpenAI-compatible transcription endpoint base url.
SPEECHTOTEXT_BASE_URL=<transcription-base-url>
# Transcription model served by that endpoint.
SPEECHTOTEXT_MODEL=<transcription-model>
# Spoken-language hint passed to the transcriber.
SPEECHTOTEXT_LANGUAGE=<language-code>
# Proper-noun hint prepended to each transcription request.
SPEECHTOTEXT_PROMPT=<transcription-prompt>
# Correction reference document used ONLY as the pre-transcription proper-noun hint;
# the transcript body itself is never rewritten (AGENTS.md 「용어 교정 위치 규칙」).
SPEECHTOTEXT_GLOSSARY=<path-to-correction-reference>
# meeting CLI invoked as the child that turns a transcript into minutes.
SPEECHTOTEXT_MEETING_CLI=<path-to-meeting-cli>
# Mounted speechtotext scripts directory used by the Drive watcher.
SPEECHTOTEXT_SCRIPTS=<path-to-speechtotext-scripts>
# speechtotext CLI invoked by the Drive watcher.
SPEECHTOTEXT_CLI=<path-to-speechtotext-cli>
# Directory holding the canonical markdown transcripts.
SPEECHTOTEXT_TRANSCRIPT_DIR=<path-to-transcripts>
# Watched Drive folder path; unset means the watcher does nothing.
SPEECHTOTEXT_DRIVE_FOLDER=<drive-folder-path>
# Processed-recording state file for the Drive watcher.
SPEECHTOTEXT_STATE_FILE=<path-to-speechtotext-state>
# whisper.cpp binary used for local transcription.
SPEECHTOTEXT_WHISPER_BIN=<path-to-whisper-cli>
# ggml model file used for local transcription.
SPEECHTOTEXT_WHISPER_MODEL=<path-to-ggml-model>
# Decoding thread count for local transcription.
SPEECHTOTEXT_WHISPER_THREADS=<thread-count>
# Wall-clock ceiling in seconds for one local transcription.
SPEECHTOTEXT_LOCAL_TIMEOUT=<timeout-seconds>
# Accept a transcript whose coverage check flagged a gap when set to one.
SPEECHTOTEXT_ALLOW_INCOMPLETE=<allow-incomplete-flag>
# ffmpeg binary used to normalise audio and cut upload windows.
SPEECHTOTEXT_FFMPEG_BIN=<path-to-ffmpeg>
# ffprobe binary used to read the true media duration.
SPEECHTOTEXT_FFPROBE_BIN=<path-to-ffprobe>

# Term correction applied when a document is generated (docs/guide/용어-교정-규약.md)
# One explicit reference file that replaces the nested Drive layers (sandbox, offline, tests).
TERM_GLOSSARY_FILE=<path-to-correction-reference>
# Node cache root for the nested reference documents; one file per document kind.
TERM_GLOSSARY_CACHE=<path-to-term-glossary-cache>
# Word-level correction audit log written by every document generator.
TERM_CORRECTION_LOG=<path-to-correction-log>

# Plaud lifelog sync watcher settings
# 라이프로그 필드 추출 프롬프트 경로(미설정이면 버전형 기본 자산).
PLAUD_SYNC_EXTRACT_PROMPT=<path-to-extraction-prompt>
# 요약 누락 복구 프롬프트 경로.
PLAUD_SYNC_SUMMARY_PROMPT=<path-to-summary-prompt>
# 라이프로그 LLM 호출 상한(초).
PLAUD_SYNC_LLM_TIMEOUT=<timeout-seconds>
# 라이프로그 녹음 표시 시간대(기본 Asia/Seoul).
PLAUD_SYNC_TIMEZONE=<iana-timezone>
# Plaud cloud poll interval in seconds (default 1800).
PLAUD_SYNC_POLL_SECONDS=<poll-seconds>
# Discovery lookback window in days (default 14).
PLAUD_SYNC_LOOKBACK_DAYS=<lookback-days>
# Max approval cards posted per watcher tick (default 3).
PLAUD_SYNC_MAX_POSTS=<max-posts>
# Local transcription of recording audio on the node (default 1; 0 = plan notes from the Plaud cloud transcript directly).
PLAUD_SYNC_TRANSCRIBE=<1-or-0>
# Recordings transcribed per watcher tick (default 1 — each run can take tens of minutes).
PLAUD_SYNC_TRANSCRIBE_PER_TICK=<per-tick>
# Recording-level failures before falling back to the cloud transcript (default 2; node failures never count).
PLAUD_SYNC_TRANSCRIBE_ATTEMPTS=<attempts>
# Total recording-level failures before abandoning an empty recording (default 5; node failures never count).
PLAUD_SYNC_TRANSCRIBE_GIVE_UP=<attempts>
# Minimum recording duration in milliseconds eligible for a Plaud note (default 5000).
PLAUD_SYNC_MIN_DURATION_MS=<milliseconds>
# Seconds allowed for one speechtotext CLI run (default 21600).
PLAUD_SYNC_TRANSCRIBE_TIMEOUT=<timeout-seconds>
# Size cap for one downloaded recording in bytes (default 1073741824).
PLAUD_SYNC_MAX_AUDIO_BYTES=<max-audio-bytes>

# Release-applied owner DM notice (docs/기능소개/릴리스-승인-자동-완결.md)
# Injectable node probe for the applied-release sweep; defaults to one read-only
# ssh that prints the active release pointer and the full-deployment receipt.
RELEASE_APPLIED_PROBE_CMD=<probe-command>
# Injectable read of both accounts' Hermes config for the release notice model line; defaults to
# one read-only ssh that prints `=== agent` / `=== peer` followed by each config.yaml.
RELEASE_MODELS_PROBE_CMD=<probe-command>
# Injectable transport that runs a producer at the agent account; defaults to
# automation/release_approval_remote.sh (approval decisions and applied notices).
RELEASE_APPROVAL_CMD=<transport-command>
# Active release pointer read on the node before the applied notice is sent
# (default /srv/autophagy-agent-current).
NODE_RELEASE_CURRENT=<path-to-release-pointer>

# Public leak gate (docs/기능소개/공개-누출-게이트.md)
# Private-literal denylist file; else `git config autophagy.opsRepo`/leak/denylist.txt.
# Configured but unreadable fails closed.
PUBLIC_GATE_DENYLIST=<path-to-denylist>
